# The CLI reads the environment; it does not implicitly load this file.
LAUNCH_ATLAS_MODE=local
LL2_BASE_URL=https://ll.thespacedevs.com/2.3.0/
LL2_USER_AGENT=SpaceLaunchAtlas/0.1 (local research; Romain Menant)
LOCAL_DATA_DIR=./data
# Optional warehouse settings; these are not credentials.
GCP_PROJECT_ID=placeholder-project
GCP_LOCATION=europe-west1
DBT_TARGET_DATASET=space_launch_atlas_dev
# dbt uses ADC in the Windows profile; keep passwords/tokens out of this file.
# Leave GOOGLE_APPLICATION_CREDENTIALS unset for standard user ADC discovery.
# Terraform uses local ADC; GCS is deferred. Data Studio remains disconnected pending a free-only query plan.
